# Server-only SQL authentication. Local development changes LIVE board data.
# Copy to .env.local and configure after Azure provisioning. Never commit secrets.
SQL_SERVER=your-server.database.windows.net
SQL_PORT=1433
SQL_DATABASE=dbboardprod
SQL_USER=board_app
SQL_PASSWORD=

# Operator-only migration credentials; do NOT set these on the deployed app.
SQL_MIGRATION_USER=
SQL_MIGRATION_PASSWORD=

# APP_TEST_MODE is reserved for the generated local test container.
# Do not set it for Azure or normal local development.
# Existing SQLite files are preserved but DATABASE_PATH is no longer used.

# Origin is canonical: no trailing slash. Use the actual HTTPS origin on Azure.
APP_ORIGIN=http://127.0.0.1:3000
REQUEST_IP_MODE=local
# Set your current public IP so local and Azure share the same client bucket.
LOCAL_CLIENT_IP=
# Random 32-byte secret encoded as 64 lowercase hex characters; same on both.
RATE_LIMIT_KEY_SECRET=

# Optional admin feature: scrypt hash and a random 32-byte/64-hex signing key.
# Never store the plaintext administrator password here or in source code.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Enable only after schema4, media APIs and private storage are deployed.
EDITOR_FEATURE_ENABLED=0
MEDIA_CLEANUP_ENABLED=0
# Local development: azure-cli. App Service: managed-identity (system assigned).
STORAGE_AUTH_MODE=azure-cli
STORAGE_BLOB_SERVICE_URL=https://stvibeboardimg7b1417.blob.core.windows.net
STORAGE_CONTAINER=board-images
# AZURITE_ACCOUNT / AZURITE_KEY are generated by the isolated test runner only.

# Future Entra integration: maintenance is fail-closed; routes are wired in later Tasks.
# Local and production use separate confidential clients and encryption keys.
AUTH_MODE=maintenance
ENTRA_TENANT_ID=69c1e470-4528-435a-a1ae-de98e0aac738
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Random 32 bytes / 64 lowercase hex. Server only; never NEXT_PUBLIC_*.
AUTH_ENCRYPTION_KEY=
# TEST_OIDC_* is reserved for the isolated SQL + Azurite test runner.
